# Settings for docker-compose. Copy to .env (which Git ignores) and change every value.
# Never commit the real .env.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, a digit and a symbol.
SQL_SA_PASSWORD=Change_Me_Strong!2026

# Signs the sign-in tokens. At least 32 random characters, e.g. from: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Mobile number of the first admin account, created on first start.
ADMIN_MOBILE=9999999999

# Development shows sign-in codes on screen (no SMS needed) and turns on Swagger.
# Use Production for a real deployment, once an SMS provider is connected.
PROCARGO_ENVIRONMENT=Development
