<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The real API in memory (WebApplicationFactory).
      Api/        no database: repositories are replaced by fakes; checks 400/401/403/404/409 and ProblemDetails.
      SqlServer/  the whole stack down to the stored procedures. Runs only when PROCARGO_TEST_SQL
                  holds a connection string to a database installed with database/install-all.sql.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProCargo.API\ProCargo.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
