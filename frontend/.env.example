# Copy to .env.development.local (or .env.production.local) and adjust.
# Where the ProCargo API lives, including the version prefix. No trailing slash.
#   Local API started with `dotnet run`:   https://localhost:7001/api/v1
#   Behind the same host (Docker/nginx):   /api/v1
VITE_API_BASE_URL=https://localhost:7001/api/v1
